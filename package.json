{
  "name": "pointer-bubble-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moyarich/pointer-bubble-playground",
    "dev:playground": "npm run dev --workspace @moyarich/pointer-bubble-playground",
    "preview": "npm run preview --workspace @moyarich/pointer-bubble-playground",
    "build": "npm run build:lib && npm run build:playground",
    "build:lib": "npm run build --workspace @moyarich/pointer-bubble",
    "build:playground": "npm run build --workspace @moyarich/pointer-bubble-playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @moyarich/pointer-bubble",
    "pack:lib": "npm pack --workspace @moyarich/pointer-bubble --dry-run",
    "release:check": "node scripts/publish.mjs --dry-run",
    "publish:first": "node scripts/publish.mjs --publish-first",
    "stage:lib": "node scripts/publish.mjs --stage",
    "publish:lib": "npm run stage:lib",
    "demo:readme": "node scripts/demos/readme.mjs",
    "screenshots:readme": "npm run demo:readme",
    "tasks": "bash scripts/tasks.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/pointer-bubble.git"
  }
}
